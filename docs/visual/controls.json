{
  "schema_version": 1,
  "name": "xdzip shared interactive controls",
  "units": "logical pixels; HTML source CSS divides by XDZIP_DISPLAY_SPEC.sourceToLogical",
  "size": {
    "menuWidth": 240,
    "menuMinWidth": 208,
    "menuRowHeight": 32,
    "menuPadding": 6,
    "menuRadius": 8,
    "menuGap": 4,
    "menuIconSize": 18,
    "menuLabelSize": 13,
    "menuShortcutSize": 12,
    "menuLabelInset": 8,
    "menuViewportInset": 8,
    "tooltipMaxWidth": 320,
    "tooltipPadding": 8,
    "focusWidth": 2
  },
  "motion": {
    "hoverDelayMs": 450,
    "submenuDelayMs": 120,
    "tooltipDurationMs": 7000,
    "typeaheadResetMs": 650,
    "pressTransitionMs": 90,
    "respectReducedMotion": true
  },
  "light": {
    "controlHover": "#EDF2FF",
    "controlPressed": "#E0E8FF",
    "menuHover": "#E8EEFF",
    "menuBorder": "#DDE3EF",
    "menuText": "#20232A",
    "menuSecondary": "#626874",
    "menuDisabled": "#959DAA",
    "menuSurface": "#FFFFFF",
    "menuDanger": "#B93848",
    "menuShadow": "#1B294329",
    "tooltipSurface": "#202B41",
    "tooltipText": "#FFFFFF"
  },
  "dark": {
    "controlHover": "#2B374C",
    "controlPressed": "#34435C",
    "menuHover": "#34435C",
    "menuBorder": "#3B465B",
    "menuText": "#ECEEF3",
    "menuSecondary": "#A2A8B4",
    "menuDisabled": "#758196",
    "menuSurface": "#242C3A",
    "menuDanger": "#FFA0AD",
    "menuShadow": "#00000066",
    "tooltipSurface": "#E3EBF9",
    "tooltipText": "#182030"
  },
  "states": [
    "normal",
    "hover",
    "pressed",
    "focus",
    "disabled",
    "checked",
    "busy",
    "error"
  ],
  "menu_roles": [
    "menuitem",
    "menuitemcheckbox",
    "menuitemradio",
    "separator",
    "submenu"
  ],
  "shadow": {
    "radius": 12,
    "offsetY": 4
  }
}
