{
  "schema_version": 1,
  "mode": "shadow",
  "plain_documents": ["docs/README.md"],
  "max_files": 200,
  "max_diff_bytes": 1048576,
  "max_document_bytes": 131072,
  "html_inputs": [
    "design/**",
    "resources/i18n/**",
    "docs/visual/*.json",
    "docs/ux/chinese-terminology.*",
    "scripts/*html*",
    "scripts/*asset*",
    "scripts/*brand*",
    "scripts/*directory-tree*",
    "scripts/check-extract-fidelity.py",
    "scripts/check-integrity-progress.py",
    "scripts/check-add-dialog.py",
    "scripts/check-tab-strip.py",
    "scripts/generate-ui-messages.py",
    "scripts/check-ui-i18n.py",
    "scripts/ui_terminology.py",
    "scripts/generate-display-spec.py",
    "scripts/export-hifi-titlebars.py",
    "scripts/export-welcome-design.py",
    "scripts/native_browser_zoom.py",
    "scripts/generate-control-tokens.py",
    "scripts/ci-*",
    ".github/**",
    ".gitattributes",
    "Cargo.lock",
    "rust-toolchain.toml"
  ]
}
