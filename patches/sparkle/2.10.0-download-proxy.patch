+/**
+ Configure an explicit HTTP CONNECT or SOCKS5 proxy before startUpdater.
+ Call on the main thread. nil retains system proxy settings. URLs must contain
+ only a host and explicit port, without credentials. Unsupported configurations
+ fail without starting network traffic. This immutable instance setting applies
+ to both feed and archive downloads. Downloader XPC is unsupported for this API.
+ */
+- (BOOL)xdzip_setDownloadProxyURL:(nullable NSURL *)proxyURL error:(NSError * _Nullable __autoreleasing * _Nullable)error;
+
--- a/Sparkle/SUHost.h
+++ b/Sparkle/SUHost.h
@@ -23,0 +24 @@
+@property (nonatomic, copy, nullable) NSURL *xdzipDownloadProxyURL;
--- a/Sparkle/SPUUpdater.m
+++ b/Sparkle/SPUUpdater.m
@@ -145,0 +146,27 @@
+- (BOOL)xdzip_setDownloadProxyURL:(NSURL * _Nullable)proxyURL error:(NSError * __autoreleasing *)error
+{
+    BOOL valid = NSThread.isMainThread && !_startedUpdater;
+    if (proxyURL != nil) {
+        NSString *scheme = proxyURL.scheme.lowercaseString;
+        long long port = proxyURL.port.longLongValue;
+        valid = valid && ([scheme isEqualToString:@"http"] || [scheme isEqualToString:@"socks5"]) &&
+            proxyURL.host.length > 0 && port > 0 && port <= 65535 &&
+            proxyURL.user == nil && proxyURL.password == nil && proxyURL.query == nil &&
+            proxyURL.fragment == nil && (proxyURL.path.length == 0 || [proxyURL.path isEqualToString:@"/"]) &&
+            !SPUXPCServiceIsEnabled(SUEnableDownloaderServiceKey);
+        if (@available(macOS 14.0, *)) {
+        } else {
+            valid = NO;
+        }
+    }
+    if (!valid) {
+        if (error != NULL) {
+            *error = [NSError errorWithDomain:SUSparkleErrorDomain code:SUInvalidUpdaterError
+                userInfo:@{NSLocalizedDescriptionKey: @"The explicit update proxy is unsupported or cannot be changed after starting the updater."}];
+        }
+        return NO;
+    }
+    _host.xdzipDownloadProxyURL = proxyURL;
+    return YES;
+}
+
