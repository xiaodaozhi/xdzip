+/**
+ Configure immutable system, direct, or HTTP CONNECT/SOCKS5 transport before
+ startUpdater on the main thread. Only custom mode accepts a proxy URL, containing
+ a host and explicit port without credentials. Direct mode disables session
+ proxies and PAC/WPAD. Unsupported configurations fail before network traffic.
+ The policy applies to feed and archive downloads. Non-system Downloader XPC is
+ unsupported. No trust or TLS configuration is accepted by this API.
+ */
+- (BOOL)xdzip_setDownloadProxyMode:(SPUXdzipDownloadProxyMode)mode proxyURL:(nullable NSURL *)proxyURL error:(NSError * _Nullable __autoreleasing * _Nullable)error;
+
+// Compatibility entry point: nil means system, never direct.
+- (BOOL)xdzip_setDownloadProxyURL:(nullable NSURL *)proxyURL error:(NSError * _Nullable __autoreleasing * _Nullable)error;
+
