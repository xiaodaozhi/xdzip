+++ b/Sparkle/SPUUpdater.m
@@ -145,0 +146,37 @@
+- (BOOL)xdzip_setDownloadProxyURL:(NSURL * _Nullable)proxyURL error:(NSError * __autoreleasing *)error
+{
+    return [self xdzip_setDownloadProxyMode:proxyURL == nil ? SPUXdzipDownloadProxySystem : SPUXdzipDownloadProxyCustom proxyURL:proxyURL error:error];
+}
+
+- (BOOL)xdzip_setDownloadProxyMode:(SPUXdzipDownloadProxyMode)mode proxyURL:(NSURL * _Nullable)proxyURL error:(NSError * __autoreleasing *)error
+{
+    BOOL valid = NSThread.isMainThread && !_startedUpdater &&
+        (mode == SPUXdzipDownloadProxySystem || mode == SPUXdzipDownloadProxyDirect || mode == SPUXdzipDownloadProxyCustom) &&
+        ((mode == SPUXdzipDownloadProxyCustom) == (proxyURL != nil));
+    if (proxyURL != nil) {
+        NSString *scheme = proxyURL.scheme.lowercaseString;
+        long long port = proxyURL.port.longLongValue;
+        valid = valid && ([scheme isEqualToString:@"http"] || [scheme isEqualToString:@"socks5"]) &&
+            proxyURL.host.length > 0 && port > 0 && port <= 65535 &&
+            proxyURL.user == nil && proxyURL.password == nil && proxyURL.query == nil &&
+            proxyURL.fragment == nil && (proxyURL.path.length == 0 || [proxyURL.path isEqualToString:@"/"]);
+    }
+    if (mode != SPUXdzipDownloadProxySystem) {
+        valid = valid && !SPUXPCServiceIsEnabled(SUEnableDownloaderServiceKey);
+        if (@available(macOS 14.0, *)) {
+        } else {
+            valid = NO;
+        }
+    }
+    if (!valid) {
+        if (error != NULL) {
+            *error = [NSError errorWithDomain:SUSparkleErrorDomain code:SUInvalidUpdaterError
+                userInfo:@{NSLocalizedDescriptionKey: @"The update transport is unsupported or cannot be changed after starting the updater."}];
+        }
+        return NO;
+    }
+    _host.xdzipDownloadProxyURL = proxyURL;
+    _host.xdzipDownloadDirect = mode == SPUXdzipDownloadProxyDirect;
+    return YES;
+}
