<!-- apps/desktop/packaging/linux/org.xdzip.update.policy -->

<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>xdzip contributors</vendor>
  <action id="org.xdzip.update">
    <description>Install a verified xdzip update</description>
    <description xml:lang="zh_CN">安装经过验证的 xdzip 更新</description>
    <message>Authentication is required to update xdzip</message>
    <message xml:lang="zh_CN">更新 xdzip 需要管理员授权</message>
    <icon_name>xdzip</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/xdzip-update-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">--request</annotate>
  </action>
</policyconfig>
