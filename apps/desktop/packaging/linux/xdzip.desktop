[Desktop Entry]
Type=Application
Name=xdzip
Comment=Browse and extract ZIP, TAR and TAR.GZ archives
Comment[zh_CN]=浏览和解压 ZIP、TAR 和 TAR.GZ 压缩文件
Exec=xdzip -- %f
Icon=xdzip
Terminal=false
Categories=Utility;Archiving;
StartupWMClass=xdzip
MimeType=application/zip;application/x-tar;application/x-compressed-tar;
