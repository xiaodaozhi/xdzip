[Desktop Entry]
Type=Application
Name=xdzip
Comment=Browse and extract ZIP, TAR, TAR.GZ, 7z, RAR, CAB, ISO and UDF files
Comment[zh_CN]=浏览和解压 ZIP、TAR、TAR.GZ、7z、RAR、CAB、ISO 和 UDF 文件
Exec=xdzip -- %f
Icon=xdzip
Terminal=false
Categories=Utility;Archiving;
StartupWMClass=xdzip
MimeType=application/zip;application/x-xpinstall;application/vnd.android.package-archive;application/vnd.comicbook+zip;application/x-cbz;application/x-tar;application/x-compressed-tar;application/x-7z-compressed;application/gzip;application/x-gzip;application/x-bzip2;application/x-bzip;application/bzip2;application/x-bzip2-compressed-tar;application/x-bzip-compressed-tar;application/x-lzma;application/x-lzma-compressed-tar;application/lzip;application/x-lzip;application/x-lzip-compressed-tar;application/x-xz;application/x-xz-compressed-tar;application/x-lz4;application/x-lz4-compressed-tar;application/zstd;application/x-zstd-compressed-tar;application/x-compress;application/x-brotli;text/x-uuencode;application/x-asar;application/x-lha;application/x-lharc;application/vnd.debian.binary-package;application/vnd.rar;application/x-rar;application/x-rar-compressed;application/vnd.ms-cab-compressed;application/x-cab;application/x-iso9660-image;application/x-udf;
