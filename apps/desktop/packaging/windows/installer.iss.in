[Setup]
AppId={{56DF0D26-2B26-40C4-9E85-FF0F8C8937CA}
AppName=xdzip
AppVersion=@VERSION@
VersionInfoVersion=@FILEVERSION@
AppCopyright=Copyright (C) 2026 xiaodaozhi
AppPublisher=xiaodaozhi
DefaultDirName={localappdata}\Programs\xdzip
DefaultGroupName=xdzip
DisableProgramGroupPage=yes
PrivilegesRequired=lowest
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
OutputDir=@OUTPUT@
OutputBaseFilename=@FILENAME@
SetupIconFile=@APPICON@
UninstallDisplayIcon=@RUNTIME_DIR@\xdzip.exe
Compression=lzma2
SolidCompression=yes
AppMutex=Local\xdzip.desktop.running
SetupMutex=Local\xdzip.desktop.installing
CloseApplications=no
RestartApplications=no
ChangesAssociations=yes
ChangesEnvironment=yes
UninstallLogMode=append
WizardStyle=modern
DisableWelcomePage=no
LicenseFile=@PAYLOAD@\share\notices\Microsoft-VC-runtime\license.rtf
InfoBeforeFile=@PAYLOAD@\share\notices\Windows-runtime-NOTICE.txt

[Languages]
@LANGUAGES@

[Messages]
@MESSAGES@

[CustomMessages]
@CUSTOM_MESSAGES@

[Tasks]
Name: "clipath"; Description: "{cm:AddCliPath}"; Flags: unchecked

[Files]
@MANIFEST_FILES@
Source: "@PAYLOAD@\*"; DestDir: "@RUNTIME_DIR@"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{userprograms}\xdzip"; Filename: "@RUNTIME_DIR@\xdzip.exe"

[Registry]
Root: HKCU; Subkey: "Environment"; ValueType: expandsz; ValueName: "Path"; ValueData: "{code:CliUserPath}"; Tasks: clipath; Check: CliPathSafe
Root: HKCU; Subkey: "Software\Classes\xdzip.Archive"; ValueType: string; ValueData: "xdzip archive"; Flags: uninsdeletekey
Root: HKCU; Subkey: "Software\Classes\xdzip.Archive\DefaultIcon"; ValueType: string; ValueData: """@RUNTIME_DIR@\xdzip-zip.ico"",0"
Root: HKCU; Subkey: "Software\Classes\xdzip.Archive\shell\open\command"; ValueType: string; ValueData: """@RUNTIME_DIR@\xdzip.exe"" -- ""%1"""
Root: HKCU; Subkey: "Software\Classes\Applications\xdzip.exe"; ValueType: string; ValueName: "FriendlyAppName"; ValueData: "xdzip"; Flags: uninsdeletekey
Root: HKCU; Subkey: "Software\Classes\Applications\xdzip.exe\shell\open\command"; ValueType: string; ValueData: """@RUNTIME_DIR@\xdzip.exe"" -- ""%1"""
Root: HKCU; Subkey: "Software\RegisteredApplications"; ValueType: string; ValueName: "xdzip"; ValueData: "Software\xdzip\Capabilities"; Flags: uninsdeletevalue
Root: HKCU; Subkey: "Software\xdzip\Capabilities"; ValueType: string; ValueName: "ApplicationName"; ValueData: "xdzip"; Flags: uninsdeletekey
Root: HKCU; Subkey: "Software\xdzip\Capabilities"; ValueType: string; ValueName: "ApplicationDescription"; ValueData: "ZIP, TAR, TAR.GZ, 7z, RAR, CAB, ISO, UDF"
Root: HKCU; Subkey: "Software\xdzip\Install"; ValueType: dword; ValueName: "SettingsSchema"; ValueData: "1"; Flags: uninsdeletekey
Root: HKCU; Subkey: "Software\xdzip\Install"; ValueType: string; ValueName: "Location"; ValueData: "{app}"
Root: HKCU; Subkey: "Software\xdzip\Install"; ValueType: string; ValueName: "InstallId"; ValueData: "56DF0D26-2B26-40C4-9E85-FF0F8C8937CA"
@ASSOCIATIONS@

[Code]
var UpdateGateHandle: THandle;

@ASSOCIATION_CODE@

@CLEANUP_CODE@

function NativeCreateMutex(Attributes: LongWord; InitialOwner: Boolean; Name: String): THandle;
external 'CreateMutexW@kernel32.dll stdcall';
function NativeGetLastError(): LongWord;
external 'GetLastError@kernel32.dll stdcall';

function AcquireUpdateGate(): Boolean;
var Transaction: String; I: Integer;
begin
  Result := False;
  Transaction := ExpandConstant('{param:XDZIPUPDATE|}');
  if Transaction <> '' then begin
    if Length(Transaction) <> 32 then exit;
    for I := 1 to Length(Transaction) do
      if Pos(Transaction[I], '0123456789abcdef') = 0 then exit;
    { The already-running updater owns both handles through Setup completion. }
    Result := CheckForMutexes('Local\xdzip.desktop.updating') and
      CheckForMutexes('Local\xdzip.desktop.update.' + Transaction);
    exit;
  end;
  UpdateGateHandle := NativeCreateMutex(0, False, 'Local\xdzip.desktop.updating');
  Result := (UpdateGateHandle <> 0) and (NativeGetLastError() <> 183);
end;

function InitializeSetup(): Boolean;
var Schema: Cardinal;
begin
  Result := not RegQueryDWordValue(HKCU, 'Software\xdzip\Install', 'SettingsSchema', Schema) or (Schema <= 1);
  if not Result then
    SuppressibleMsgBox(ExpandConstant('{cm:IncompatibleSettings}'), mbCriticalError, MB_OK, IDOK);
  if Result then begin
    Result := AcquireUpdateGate();
    if not Result then
      SuppressibleMsgBox(ExpandConstant('{cm:UpdateAlreadyRunning}'), mbError, MB_OK, IDOK);
  end;
end;

function CliPathSafe(): Boolean;
var Existing: String;
begin
  Existing := FileSearch('xdzip.exe', GetEnv('PATH'));
  Result := (Existing = '') or
    (CompareText(Existing, ExpandConstant('{app}\xdzip.exe')) = 0) or
    (CompareText(Existing, ExpandConstant('{app}\cli\xdzip.exe')) = 0);
  if not Result then
    Log('CLI PATH registration skipped because another xdzip command is already available.');
end;

function OwnShellCommandKey(): Boolean;
var Handler: String;
begin
  { Never claim an existing command belonging to another handler. }
  Result := not RegKeyExists(HKCU, 'Software\Classes\AllFilesystemObjects\shell\xdzip') or
    (RegQueryStringValue(HKCU, 'Software\Classes\AllFilesystemObjects\shell\xdzip',
      'ExplorerCommandHandler', Handler) and
     ((CompareText(Handler, '{54B70170-1072-49B5-9BD2-6DFB5ECBF1B1}') = 0) or
      (CompareText(Handler, '{731D9A38-549E-4CDE-B35B-6EB3A2C88B71}') = 0)));
end;

function OwnShellCommandClassKey(): Boolean;
var LibraryPath: String;
begin
  Result := not RegKeyExists(HKCU, 'Software\Classes\CLSID\{54B70170-1072-49B5-9BD2-6DFB5ECBF1B1}') or
    (RegQueryStringValue(HKCU, 'Software\Classes\CLSID\{54B70170-1072-49B5-9BD2-6DFB5ECBF1B1}\InprocServer32', '', LibraryPath) and
     (CompareText(ExtractFileDir(LibraryPath), ExpandConstant('{app}\shell')) = 0) and
     (Pos('xdzip-shell-', Lowercase(ExtractFileName(LibraryPath))) = 1) and
     (CompareText(ExtractFileExt(LibraryPath), '.dll') = 0));
end;

function CliUserPath(Param: String): String;
var Existing, Entry: String;
begin
  RegQueryStringValue(HKCU, 'Environment', 'Path', Existing);
  Entry := ExpandConstant('{app}\cli');
  if Pos(';' + Lowercase(Entry) + ';', ';' + Lowercase(Existing) + ';') > 0 then
    Result := Existing
  else if Existing = '' then
    Result := Entry
  else
    Result := Entry + ';' + Existing;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var Existing, Entry, Item, Updated: String; At: Integer;
begin
  if CurUninstallStep <> usPostUninstall then exit;
  if not RegQueryStringValue(HKCU, 'Environment', 'Path', Existing) then exit;
  Entry := ExpandConstant('{app}\cli');
  Updated := '';
  while Existing <> '' do begin
    At := Pos(';', Existing);
    if At = 0 then begin Item := Existing; Existing := ''; end
    else begin Item := Copy(Existing, 1, At - 1); Delete(Existing, 1, At); end;
    if CompareText(Item, Entry) <> 0 then begin
      if Updated <> '' then Updated := Updated + ';';
      Updated := Updated + Item;
    end;
  end;
  RegWriteExpandStringValue(HKCU, 'Environment', 'Path', Updated);
end;

@SHELL_HOOKS@
