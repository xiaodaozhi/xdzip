// Both desktop entry executables carry the same application identity and icon.
// Format-specific document icons remain separate installer payloads.
#define IDI_XDZIP_APP_ICON 1
IDI_XDZIP_APP_ICON ICON "@XDZIP_APP_ICON_ICO@"

1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@XDZIP_BUILD_NUMBER@
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@XDZIP_BUILD_NUMBER@
FILEFLAGSMASK 0x3fL
FILEFLAGS @XDZIP_FILE_FLAGS@
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "@XDZIP_RESOURCE_DESCRIPTION@\0"
            VALUE "FileVersion", "@XDZIP_DISPLAY_VERSION@\0"
            VALUE "ProductName", "xdzip\0"
            VALUE "ProductVersion", "@XDZIP_DISPLAY_VERSION@\0"
            VALUE "OriginalFilename", "@XDZIP_RESOURCE_FILENAME@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
