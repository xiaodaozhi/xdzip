// The application icon is embedded in the executable for Explorer and the taskbar.
// ZIP document icons are delivered separately for a future installer.
#define IDI_XDZIP_APP_ICON 1
IDI_XDZIP_APP_ICON ICON "@XDZIP_APP_ICON_ICO@"

1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@XDZIP_BUILD_NUMBER@
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@XDZIP_BUILD_NUMBER@
FILEFLAGSMASK 0x3fL
FILEFLAGS @XDZIP_FILE_FLAGS@
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "xdzip ZIP archive browser\0"
            VALUE "FileVersion", "@XDZIP_DISPLAY_VERSION@\0"
            VALUE "ProductName", "xdzip\0"
            VALUE "ProductVersion", "@XDZIP_DISPLAY_VERSION@\0"
            VALUE "OriginalFilename", "xdzip.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
